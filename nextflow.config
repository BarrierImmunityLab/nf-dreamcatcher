manifest {
    name = 'nf-dreamcatcher'
    homePage = 'https://github.com/BarrierImmunityLab/nf-dreamcatcher'
    mainScript = 'main.nf'
    nextflowVersion = '!>=26.10.4'
}

nextflow.enable.moduleBinaries = true

params {
    input = 'samplesheets/samples.csv'
    local_dev_dir = './local_dev'
    dreamcatcher_refdata_root = "${params.local_dev_dir}/refdata_dreamcatcher"
    user = "${System.getenv('USER')}"
    pipeline_name = 'nf-dreamcatcher'
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

workDir = "${params.local_dev_dir}/work"
outputDir = "${params.local_dev_dir}/results"
singularity.enabled = true
singularity.autoMounts = false
singularity.cacheDir = "${params.local_dev_dir}/singularity"
singularity.pullTimeout = 60.m

process {
    withName: KRAKENUNIQ {
        errorStrategy = 'retry'
        maxRetries = 2
    }
    errorStrategy = 'ignore'
}

profiles {
    qimrb {
        workDir = "/working/lab_amandao/${params.user}/${params.pipeline_name}/work"
        outputDir = "/working/lab_amandao/${params.user}/${params.pipeline_name}/results"
        params {
            dreamcatcher_refdata_root = '/working/lab_amandao/shared/barrier-atlas/assets/refdata_dreamcatcher/'
        }
        singularity.cacheDir = "/working/lab_amandao/${params.user}/${params.pipeline_name}/assets/singularity"
        singularity.runOptions = '-B /working'
        process {
            withLabel: use_singularity {
                beforeScript = 'module load singularity/3.11.4'
            }
        }
    }
    pbspro {
        executor {
            '$local' {
                cpus = 4
            }
        }
        process {
            executor = 'pbspro'
            cpus = 1
            memory = 1.GB
            time = 24.h
        }
        includeConfig 'conf/pbspro.config'
    }
    trace {
        trace {
            enabled = true
            file = "trace/${params.trace_timestamp}.csv"
            fields = 'task_id,native_id,status,exit,process,cpus,memory,realtime,peak_rss,%cpu,rchar,wchar,tag,name,workdir'
            sep = ','
            raw = false
            overwrite = true
        }
    }
    stub {
        workDir = "${params.local_dev_dir}/stub/work"
        outputDir = "${params.local_dev_dir}/stub/results"
        params {
            input = "${projectDir}/tests/stub/samples.csv"
            dreamcatcher_refdata_root = "${projectDir}/tests/stub/refdata"
        }
        singularity.enabled = false
        process {
            executor = 'local'
            cpus = 1
            memory = 1.GB
            withName: '.*' {
                errorStrategy = 'terminate'
            }
        }
    }
}
