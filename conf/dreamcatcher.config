process {
    withName: '.*DREAMCATCHER:(.*:)?MAKE_UMI_FASTQ' {
        cpus = 2
        memory = 2.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?GET_BARCODE_CORRECTIONS' {
        cpus = 4
        memory = 2.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?CORRECT_BARCODES' {
        cpus = 4
        memory = 2.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?MAKE_BULK_FASTQ' {
        cpus = 2
        memory = 2.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?KRAKENUNIQ' {
        cpus = 4
        memory = 192.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?KUNIQ_TO_GCF' {
        memory = 1.GB
        time = 30.m
    }
    withName: '.*DREAMCATCHER:(.*:)?MAKE_COMBINED_REFERENCE_.*' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?HISAT2_BUILD_DETECTED' {
        cpus = 8
        memory = 16.GB
        time = 3.h
    }
    withName: '.*DREAMCATCHER:(.*:)?HISAT2_BUILD_TOP' {
        cpus = 4
        memory = 4.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?HISAT2_MAP_HUMAN' {
        cpus = 16
        memory = 32.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?HISAT2_MAP_DETECTED' {
        cpus = 16
        memory = 16.GB
        time = 4.h
    }
    withName: '.*DREAMCATCHER:(.*:)?HISAT2_MAP_TOP' {
        cpus = 16
        memory = 4.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?FEATURECOUNTS_DETECTED' {
        cpus = 2
        memory = 2.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?FEATURECOUNTS_TOP|.*DREAMCATCHER:(.*:)?FEATURECOUNTS_SORT_.*' {
        cpus = 2
        memory = 2.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?ANNOTATE_MAPPED_READS_.*' {
        cpus = 2
        memory = 4.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?EXTRACT_GENE_BIOTYPES' {
        memory = 1.GB
        time = 30.m
    }
    withName: '.*DREAMCATCHER:(.*:)?MAKE_SUMMARY_TABLES_.*' {
        memory = 4.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?FILTER_STRAINS' {
        memory = 1.GB
        time = 30.m
    }
    withName: '.*DREAMCATCHER:(.*:)?GET_SHARED_UNIQ_READS' {
        cpus = 4
        memory = 8.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?MAKE_READ_NETWORK_.*' {
        memory = 2.GB
        time = 30.m
    }
    withName: '.*DREAMCATCHER:(.*:)?PARSE_READ_NETWORK' {
        memory = 2.GB
        time = 1.h
    }
    withName: '.*DREAMCATCHER:(.*:)?FILTER_TOP_GFF' {
        memory = 2.GB
        time = 30.m
    }
    withName: '.*DREAMCATCHER:(.*:)?UMI_TOOLS_COUNT_.*' {
        memory = 4.GB
        time = 2.h
    }
    withName: '.*DREAMCATCHER:(.*:)?BARCODE_TO_SPECIES' {
        memory = 2.GB
        time = 30.m
    }
    withName: '.*DREAMCATCHER:(.*:)?MAPSTATS' {
        cpus = 2
        memory = 2.GB
        time = 1.h
    }
}
